{
  // Static landing page for Squish, served by Cloudflare Workers static assets.
  "name": "squish",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  // Keep the original workers.dev address working for links shared before the custom domain.
  "workers_dev": true,
  "routes": [
    { "pattern": "squish.madebyvu.com", "custom_domain": true }
  ]
}
