# Generated by scripts/release.sh from squish.rb.in — edit the template, not squish.rb.
cask "squish" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/vunguyentuan/squish/releases/download/v#{version}/Squish.dmg",
      verified: "github.com/vunguyentuan/squish/"
  name "Squish"
  desc "Image and video optimizer"
  homepage "https://squish.madebyvu.com/"

  livecheck do
    url "https://squish.madebyvu.com/appcast.xml"
    strategy :sparkle, &:short_version
  end

  auto_updates true
  depends_on arch: :arm64
  depends_on macos: ">= :tahoe"

  app "Squish.app"
  # The app binary is also the command-line tool when run as `squish`.
  binary "#{appdir}/Squish.app/Contents/MacOS/Squish", target: "squish"

  zap trash: [
    "~/Library/Application Support/Squish",
    "~/Library/Caches/dev.squish.Squish",
    "~/Library/HTTPStorages/dev.squish.Squish",
    "~/Library/Preferences/dev.squish.Squish.plist",
  ]
end
