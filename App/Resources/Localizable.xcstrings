            "value": "今すぐシェルフを表示"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện khay ngay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即显示拖放架"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Finder anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar en el Finder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher dans le Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderに表示"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị trong Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中显示"
          }
        }
      }
    },
    "Shrinks a copied screenshot or image before you paste it. PNG stays PNG and JPEG stays JPEG, so every app can paste it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkleinert ein kopiertes Bildschirmfoto oder Bild, bevor du es einsetzt. PNG bleibt PNG und JPEG bleibt JPEG, sodass jede App es einsetzen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce una captura de pantalla o imagen copiada antes de pegarla. PNG sigue siendo PNG y JPEG sigue siendo JPEG, así que cualquier app puede pegarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit une capture d'écran ou une image copiée avant de la coller. Le PNG reste PNG et le JPEG reste JPEG, pour que toutes les apps puissent la coller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたスクリーンショットや画像を、ペーストする前に縮小します。PNGはPNG、JPEGはJPEGのままなので、どのアプリにもペーストできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu nhỏ ảnh chụp màn hình hoặc ảnh đã sao chép trước khi bạn dán. PNG vẫn là PNG và JPEG vẫn là JPEG, nên ứng dụng nào cũng dán được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在粘贴前压缩拷贝的截屏或图像。PNG 仍为 PNG，JPEG 仍为 JPEG，因此任何 App 都能粘贴。"
          }
        }
      }
    },
    "Shrinks images and videos with Squish and returns the optimized files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkleinert Bilder und Videos mit Squish und gibt die optimierten Dateien zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce imágenes y vídeos con Squish y devuelve los archivos optimizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit des images et vidéos avec Squish et renvoie les fichiers optimisés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Squishで画像やビデオを縮小し、最適化されたファイルを返します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu nhỏ ảnh và video bằng Squish rồi trả về các tệp đã tối ưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Squish 压缩图像和视频，并返回优化后的文件。"
          }
        }
      }
    },
    "Shrinks the image on the clipboard in place, keeping it PNG or JPEG so it pastes anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkleinert das Bild direkt in der Zwischenablage und behält PNG oder JPEG bei, damit es sich überall einsetzen lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce la imagen del portapapeles en su sitio y la mantiene en PNG o JPEG para que se pueda pegar en cualquier lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit l'image du presse-papiers sur place en la gardant en PNG ou JPEG, pour pouvoir la coller partout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード上の画像をそのまま縮小します。PNGまたはJPEGのまま保持されるので、どこにでもペーストできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu nhỏ trực tiếp ảnh trong bộ nhớ tạm, giữ định dạng PNG hoặc JPEG để dán được ở mọi nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接压缩剪贴板中的图像，并保持 PNG 或 JPEG 格式，以便粘贴到任何地方。"
          }
        }
      }
    },
