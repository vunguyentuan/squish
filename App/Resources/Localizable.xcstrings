    "%@ Converted files (WebP, AVIF, JPEG) are always saved next to the original.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Konvertierte Dateien (WebP, AVIF, JPEG) werden immer neben dem Original gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Los archivos convertidos (WebP, AVIF, JPEG) siempre se guardan junto al original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Les fichiers convertis (WebP, AVIF, JPEG) sont toujours enregistrés à côté de l'original."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 変換したファイル（WebP、AVIF、JPEG）は常に元のファイルと同じ場所に保存されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Các tệp được chuyển đổi (WebP, AVIF, JPEG) luôn được lưu bên cạnh tệp gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 转换后的文件（WebP、AVIF、JPEG）始终存储在原始文件旁边。"
          }
        }
      }
    },
    "%@ can't be optimized in place. Pick an output format to convert it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht direkt optimiert werden. Wähle ein Ausgabeformat, um die Datei zu konvertieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se puede optimizar en su sitio. Elige un formato de salida para convertirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas être optimisé sur place. Choisissez un format de sortie pour le convertir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はその場で最適化できません。変換するには出力フォーマットを選択してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tối ưu hóa %@ tại chỗ. Hãy chọn định dạng đầu ra để chuyển đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法原位优化。请选择输出格式进行转换。"
          }
        }
      }
    },
