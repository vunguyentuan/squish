    "Shake the cursor while dragging files to open the drop shelf": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiger beim Ziehen von Dateien schütteln, um die Ablage zu öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agita el cursor mientras arrastras archivos para abrir la bandeja de arrastre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secouez le curseur en faisant glisser des fichiers pour ouvrir la zone de dépôt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをドラッグ中にポインタを振るとドロップシェルフが開きます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lắc con trỏ khi kéo tệp để mở khay thả"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移文件时晃动指针以打开拖放架"
          }
        }
      }
    },
    "Shake the pointer while dragging files to open the drop shelf.": {
      "localizations": {
        "de": {
