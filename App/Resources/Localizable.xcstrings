            "value": "Motor escrito en Rust. Incluye libimagequant (GPL-3.0), mozjpeg (BSD/IJG), libwebp (BSD), rav1e (BSD-2), oxipng (MIT), OXVG (MIT)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moteur écrit en Rust. Comprend libimagequant (GPL-3.0), mozjpeg (BSD/IJG), libwebp (BSD), rav1e (BSD-2), oxipng (MIT), OXVG (MIT)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンはRustで記述されています。libimagequant（GPL-3.0）、mozjpeg（BSD/IJG）、libwebp（BSD）、rav1e（BSD-2）、oxipng（MIT）、OXVG（MIT）を含みます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ máy được viết bằng Rust. Bao gồm libimagequant (GPL-3.0), mozjpeg (BSD/IJG), libwebp (BSD), rav1e (BSD-2), oxipng (MIT), OXVG (MIT)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
