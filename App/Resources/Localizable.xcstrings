    "GIF can't be optimized in place. Convert it to WebP or MP4.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF kann nicht direkt optimiert werden. Konvertiere die Datei in WebP oder MP4."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los GIF no se pueden optimizar en su sitio. Conviértelo a WebP o MP4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les GIF ne peuvent pas être optimisés sur place. Convertissez-le en WebP ou MP4."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFはその場で最適化できません。WebPまたはMP4に変換してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tối ưu hóa GIF tại chỗ. Hãy chuyển sang WebP hoặc MP4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 无法原位优化。请将其转换为 WebP 或 MP4。"
