    "Larger images and videos are scaled down so their longest side fits. Resizing always re-encodes, even in Lossless mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere Bilder und Videos werden verkleinert, bis ihre längste Seite passt. Beim Skalieren wird immer neu codiert, auch im Modus „Verlustfrei“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes y vídeos más grandes se reducen para que su lado más largo quepa. Redimensionar siempre vuelve a codificar, incluso en modo Sin pérdida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images et vidéos plus grandes sont réduites pour que leur plus grand côté tienne dans la limite. Le redimensionnement réencode toujours, même en mode Sans perte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな画像やビデオは長辺が収まるように縮小されます。リサイズすると「ロスレス」モードでも常に再エンコードされます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh và video lớn hơn sẽ được thu nhỏ để cạnh dài nhất vừa giới hạn. Thay đổi kích thước luôn mã hóa lại, kể cả ở chế độ Không mất dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较大的图像和视频会被缩小，使最长边符合限制。调整大小总会重新编码，即使在“无损”模式下也是如此。"
          }
        }
      }
    },
    "Launch Squish at login": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Squish bei der Anmeldung starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Squish al iniciar sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Squish à l'ouverture de session"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時にSquishを起動"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Squish khi đăng nhập"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动 Squish"
          }
        }
      }
    },
    "Longest side in pixels. Leave empty to use Squish's setting, or 0 to keep the size.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Längste Seite in Pixeln. Leer lassen, um die Einstellung von Squish zu verwenden, oder 0, um die Größe beizubehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lado más largo en píxeles. Déjalo vacío para usar el ajuste de Squish, o 0 para mantener el tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus grand côté en pixels. Laissez vide pour utiliser le réglage de Squish, ou 0 pour conserver la taille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長辺のピクセル数。空欄にするとSquishの設定を使用し、0にするとサイズを維持します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cạnh dài nhất tính bằng pixel. Để trống để dùng cài đặt của Squish, hoặc 0 để giữ nguyên kích thước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最长边的像素数。留空则使用 Squish 的设置，填 0 则保持原尺寸。"
          }
        }
      }
    },
    "Lossless": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlustfrei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin pérdida"
