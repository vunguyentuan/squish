            "value": "Recodificación trellis con mozjpeg o transcodificación sin pérdida al estilo jpegtran — la que ocupe menos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réencodage trellis mozjpeg ou transcodage sans perte façon jpegtran — le plus léger des deux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mozjpegのトレリス再エンコード、またはjpegtran方式のロスレス変換 — 小さくなる方を採用"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã hóa lại bằng mozjpeg trellis, hoặc chuyển mã không mất dữ liệu kiểu jpegtran — chọn cách cho tệp nhỏ hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mozjpeg trellis 重新编码，或 jpegtran 式无损转码——取两者中较小者"
          }
        }
      }
    },
