    "New images and videos saved into these folders are optimized automatically with your current settings. Subfolders aren't watched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Bilder und Videos, die in diesen Ordnern gesichert werden, werden automatisch mit deinen aktuellen Einstellungen optimiert. Unterordner werden nicht überwacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas imágenes y vídeos que se guarden en estas carpetas se optimizan automáticamente con tus ajustes actuales. No se vigilan las subcarpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles images et vidéos enregistrées dans ces dossiers sont optimisées automatiquement avec vos réglages actuels. Les sous-dossiers ne sont pas surveillés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのフォルダに保存された新しい画像やビデオは、現在の設定で自動的に最適化されます。サブフォルダは監視されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh và video mới được lưu vào các thư mục này sẽ tự động được tối ưu hóa theo cài đặt hiện tại của bạn. Thư mục con không được theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储到这些文件夹中的新图像和视频会按当前设置自动优化。子文件夹不受监视。"
          }
        }
      }
    },
